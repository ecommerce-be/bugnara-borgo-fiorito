# ===========================================================
# Bugnara Borgo Fiorito - Backend environment variables example
# ===========================================================
# Copy this file to ".env" and fill with your real values.
# NEVER commit the real .env to Git — it's in .gitignore.

# --- Profile ---
# Use 'dev' for local development (H2 in-memory DB)
# Use 'prod' for production (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database (only needed in 'prod' profile) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/borghetto
DATABASE_USERNAME=borghetto
DATABASE_PASSWORD=change-me-in-real-env

# --- CORS allowed origins (comma-separated) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Future: Cloudinary credentials (Phase 4) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Future: JWT secret for admin auth (Phase 5) ---
# JWT_SECRET=generate-a-long-random-string-here
# JWT_EXPIRATION_MS=86400000

# --- Future: SMTP for sending emails (Phase 4) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ciao@bugnarafiorito.it
