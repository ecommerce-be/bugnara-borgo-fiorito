# ===========================================================
# Bugnara Borgo Fiorito - Environment variables example
# ===========================================================
# Copy this file to ".env" (in the project root) and fill with real values.
# NEVER commit the real .env to Git — it's in .gitignore.
# ===========================================================

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (only needed in 'prod' profile) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/borghetto
# DATABASE_USERNAME=borghetto
# DATABASE_PASSWORD=change-me

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (admin authentication) ---
# Secret used to sign JWTs. MUST be at least 32 characters long.
# Generate with: openssl rand -hex 32
# Or in PowerShell: -join ((48..57) + (97..122) | Get-Random -Count 64 | %{[char]$_})
JWT_SECRET=
# How long an access token is valid, in milliseconds. Default: 24h (86400000).
JWT_EXPIRATION_MS=86400000

# --- Cloudinary (photo storage + CDN) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bugnara_spots

# --- Resend (transactional emails) ---
RESEND_API_KEY=
RESEND_FROM=Bugnara Borgo Fiorito <onboarding@resend.dev>
RESEND_ADMIN_INBOX=
