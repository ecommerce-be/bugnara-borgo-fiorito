# ===========================================================
# Bugnara Borgo Fiorito - Environment variables example
# ===========================================================
# Copy this file to ".env" (in the project root) and fill with real values.
# NEVER commit the real .env to Git — it's in .gitignore.
#
# How to load on Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#     }
#   }
#   cd backend; mvn spring-boot:run
#
# Or simply pass them inline:
#   $env:CLOUDINARY_CLOUD_NAME="..."; mvn spring-boot:run
# ===========================================================

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (only needed in 'prod' profile) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/borghetto
# DATABASE_USERNAME=borghetto
# DATABASE_PASSWORD=change-me

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin API key (temporary, replaced by JWT in Phase 5) ---
# Generate a long random string. Used in X-Admin-Key header for admin endpoints.
# Example: openssl rand -hex 32  (or any password manager)
APP_ADMIN_API_KEY=

# --- Cloudinary (photos storage + CDN) ---
# Get these from cloudinary.com/console (Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=bugnara_spots

# --- Resend (transactional emails) ---
# Get from resend.com -> API Keys
RESEND_API_KEY=
# In dev you can use Resend's free sender:
RESEND_FROM=Bugnara Borgo Fiorito <onboarding@resend.dev>
# IMPORTANT: in Resend free mode you can only email YOUR OWN account address
# until you verify a domain. So put your personal email here in dev.
RESEND_ADMIN_INBOX=

# --- Future: JWT secret for admin auth (Phase 5) ---
# JWT_SECRET=
# JWT_EXPIRATION_MS=86400000
